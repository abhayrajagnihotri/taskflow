# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection
DATABASE_URL="postgresql://taskflow:taskflow_password@localhost:5432/taskflow"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379

# Authentication & JWT Secrets
JWT_ACCESS_SECRET="taskflow_jwt_access_secret_key_change_in_production"
JWT_REFRESH_SECRET="taskflow_jwt_refresh_secret_key_change_in_production"

# Token TTL Settings
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"
